# Example nginx reverse-proxy vhost for PrintLib.
#
# Copy this into your nginx config (a standalone site, or the conf.d
# directory of an existing reverse-proxy stack), fill in the placeholders,
# and point the upstream at wherever the container's port 8000 is reachable
# — either its published host port (if you ran `docker compose up` with the
# root docker-compose.yml as-is) or its container name on a shared Docker
# network (if you added it as a service in a bigger compose stack).

upstream printlib_backend {
    server printlib:8000;   # container name:port, or 127.0.0.1:8000 for a published port
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name printlib.example.com;

    # Only needed if you're using Let's Encrypt/certbot for the cert below.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name printlib.example.com;

    ssl_certificate     /etc/letsencrypt/live/printlib.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/printlib.example.com/privkey.pem;

    # Model uploads can be sizeable zip bundles.
    client_max_body_size 500m;

    # Optional but recommended once this is reachable from the public
    # internet: restrict the login endpoint to your own LAN/VPN subnet, so
    # a guessed or leaked password isn't the only thing standing between
    # the internet and your library. Replace 192.168.1.0/24 with your own
    # LAN subnet (check with `ip route` on the host — look for the line
    # for your LAN interface). This only gates login; browsing, viewing,
    # and downloading are unaffected for everyone.
    location = /api/login {
        allow 192.168.1.0/24;
        allow 127.0.0.1;
        deny all;

        proxy_pass         http://printlib_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass         http://printlib_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
