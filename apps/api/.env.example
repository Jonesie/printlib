# Copy to .env and fill in real values. Never commit .env.

# The one shared password for logging into PrintLib.
ADMIN_PASSWORD=change-me

# Random secret used to sign the session cookie, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Optional: share print logs to Bluesky. Use an app password, not your login password.
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Public URL of this site; shared posts link back to the model page.
# PUBLIC_URL=https://printlib.example.com
