# Copy to .env and fill in real values. Never commit .env.

# The one shared password for logging into PrintLib.
ADMIN_PASSWORD=change-me

# Random secret used to sign the session cookie, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Optional: share print logs to Bluesky. Use an app password, not your login password.
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: share to a Facebook Page (Graph API). Needs the Page ID and a Page access token.
# FACEBOOK_PAGE_ID=1234567890
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: share to Instagram (Business/Creator account via the Graph API). Instagram
# downloads the photo itself, so PUBLIC_URL below must be reachable from the internet,
# and the print log must have a photo.
# INSTAGRAM_ACCOUNT_ID=1234567890
# INSTAGRAM_ACCESS_TOKEN=
# Optional: set to false to hide the "Want your own PrintLib?" panel on the home page.
# SHOW_GET_PRINTLIB_PANEL=false
# Optional: your Buy Me a Coffee username; shows a button on the home page and a
# footer link. Leave unset to hide them.
# BUYMEACOFFEE_USERNAME=yourname
# Public URL of this site; shared posts link back to the model page.
# PUBLIC_URL=https://printlib.example.com
